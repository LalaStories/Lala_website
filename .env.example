# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# --- Database (required) ---
# Pooled connection string, used by the running app.
# On Neon this is the host containing "-pooler".
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"

# Unpooled connection, used only for migrations. Required — Prisma errors
# if it is missing. On Neon this is the same host WITHOUT "-pooler".
# If your database has no pooler, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Admin auth (required) ---
# Signs admin session cookies AND salts admin password hashes.
# Changing this invalidates every existing session and password hash.
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=""

# --- Cloudinary (required for admin media uploads) ---
# Without these, image/video uploads in the admin will fail.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Contact form (optional) ---
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""

# --- Meta Pixel (optional) ---
# Site-wide pixel. Leave unset to use the Lala Stories pixel (1204980414756789).
# Set to an empty string to disable tracking, e.g. on staging.
# NEXT_PUBLIC_META_PIXEL_ID="1204980414756789"
