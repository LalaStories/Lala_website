datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Story {
  id           String   @id @default(uuid())
  title        String
  description  String
  durationText String
  ageRange     String
  badge        String?
  imageSrc     String
  audioSrc     String
  createdAt    DateTime @default(now())
}

model Testimonial {
  id           String   @id @default(uuid())
  text         String
  avatarLetter String
  authorName   String
  authorRole   String
  createdAt    DateTime @default(now())
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String   @default("")
  email     String   @default("")
  role      String   @default("editor") // "superadmin" | "editor" | "viewer"
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  imageUrl    String
  buyUrl      String
  category    String // "Book" | "Toy"
  createdAt   DateTime @default(now())
}

model PricingPlan {
  id        String   @id @default(uuid())
  name      String
  price     String
  period    String // e.g. "month", "year", "lifetime"
  features  String // Comma-separated features list
  isPopular Boolean  @default(false)
  badge     String? // e.g. "Best Value"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProgramApplication {
  id         String   @id @default(uuid())
  parentName String
  childName  String
  childAge   Int
  email      String
  phone      String?
  message    String
  status     String   @default("Pending") // "Pending", "Approved", "Rejected"
  createdAt  DateTime @default(now())
}

model BgVideo {
  id        String   @id @default(uuid())
  title     String
  videoUrl  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Program {
  id            String                @id @default(uuid())
  title         String
  description   String
  date          String // Display string e.g. "June 22, 2025"
  location      String
  imageUrl      String? // Banner/poster image
  qrImageUrl    String? // QR code image for payment/registration
  isActive      Boolean               @default(true)
  formFields    String // JSON array of dynamic field definitions
  registrations ProgramRegistration[]
  createdAt     DateTime              @default(now())
}

model ProgramRegistration {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  responses String // JSON object: { fieldLabel: value }
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

// ============================================================
//  LANDING PAGES (Meta Ads campaigns)
//  A landing page is a slug + an ordered JSON array of blocks.
//  Blocks are rendered by src/components/landing/BlockRenderer.
// ============================================================

model LandingPage {
  id          String  @id @default(uuid())
  slug        String  @unique // public URL: /lp/<slug>
  name        String // internal label shown in admin only
  isPublished Boolean @default(false)

  // SEO / social
  seoTitle       String
  seoDescription String
  ogImageUrl     String?

  // Meta Ads tracking — each campaign can use its own pixel
  metaPixelId String?

  // Page background: "stars" | "gradient" | "image" | "video"
  bgType     String  @default("stars")
  bgImageUrl String?
  bgVideoUrl String?
  bgOverlay  Int     @default(60) // dark overlay strength, 0-100

  // Ordered block list, serialised as JSON (see src/types/landing.ts)
  blocks String @default("[]")

  views Int    @default(0)
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Lead {
  id            String       @id @default(uuid())
  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  name  String
  phone String
  email String @default("")

  // Answers to any extra custom fields, as JSON { "<label>": "<value>" }
  responses String @default("{}")

  status String @default("New") // "New" | "Contacted" | "Converted" | "Rejected"
  notes  String @default("")

  // Attribution captured from the ad click
  source   String @default("")
  campaign String @default("")

  createdAt DateTime @default(now())

  @@index([landingPageId])
  @@index([status])
}
