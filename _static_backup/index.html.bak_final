<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LALA Kids — Magical Bedtime Stories for Little Dreamers</title>
  <meta name="description"
    content="Discover enchanting bedtime stories for kids. Cozy tales, soothing narration, and magical adventures to help your little ones drift off to dreamland." />
  <link rel="stylesheet" href="css/index.css" />
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌙</text></svg>" />
</head>

<body>

  <!-- ========== HEADER ========== -->
  <header class="header" id="header">
    <div class="container">
      <a href="#" class="logo" id="logo">
        <img src="assets/images/LALA logo- PNG.png" alt="LALA Stories" class="logo-img" />
      </a>
      <nav class="nav-links" id="navLinks">
        <a href="#stories">Stories</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#app-showcase">Our App</a>
        <a href="#testimonials">Reviews</a>
        <a href="#cta" class="nav-cta">Start Free ✨</a>
      </nav>
      <div class="hamburger" id="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </header>

  <!-- ========== HERO SECTION ========== -->
  <section class="hero" id="hero">
    <!-- Animated stars background -->
    <div class="hero-stars" id="heroStars"></div>

    <!-- Floating clouds -->
    <div class="hero-cloud">☁️</div>
    <div class="hero-cloud">☁️</div>
    <div class="hero-cloud">☁️</div>

    <!-- Moon -->
    <div class="hero-moon" id="heroMoon"></div>

    <!-- Twinkling particles -->
    <div class="hero-particles" id="heroParticles"></div>

    <!-- Main content -->
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          Beyond Tales
        </div>
        <h1>Where <span>Dreams</span> Begin Every Night</h1>
        <p class="hero-description">
          Magical bedtime stories crafted to spark imagination, soothe little minds,
          and carry your children to the most wonderful dreamland adventures.
        </p>
        <div class="hero-buttons">
          <a href="https://lalakidsstories.page.link/share" class="btn-primary" id="heroCtaBtn">
            Explore Stories 🚀
          </a>
          <a href="https://lalakidsstories.page.link/share" class="btn-secondary" id="heroListenBtn">
            ▶ Listen Now
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <div class="hero-stat-number">3000+</div>
            <div class="hero-stat-label">Stories</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-number">200000+</div>
            <div class="hero-stat-label">Happy Kids</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-number">4.9</div>
            <div class="hero-stat-label">Rating ⭐</div>
          </div>
        </div>
      </div>
      <div class="hero-illustration">
        <img src="assets/images/hero_illustration.png" alt="Child reading a storybook on a crescent moon"
          id="heroImage" />
      </div>
    </div>

    <!-- Wave divider -->
    <div class="hero-wave">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path d="M0,80 C360,120 720,40 1080,80 C1260,100 1380,60 1440,80 L1440,120 L0,120 Z" fill="#FFF7F0" />
      </svg>
    </div>
  </section>

  <!-- ========== FEATURED STORIES ========== -->
  <section class="section stories-section" id="stories">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <div class="section-tag">📚 Featured Stories</div>
        <h2 class="section-title">Tonight's <span>Magical</span> Tales</h2>
        <p class="section-subtitle">
          Choose from our collection of enchanting stories, each one crafted to inspire sweet dreams.
        </p>
      </div>

      <div class="stories-grid">
        <!-- Story Card 1 -->
        <div class="story-card animate-on-scroll animate-delay-1" id="storyCard1">
          <div class="story-card-image">
            <img src="assets/images/HN 119.jpg" alt="Battle of the Ants adventure" />
            <span class="story-card-badge">New</span>
            <span class="story-card-duration">🕐 8 min</span>
          </div>
          <div class="story-card-body">
            <h3 class="story-card-title">परी की जादुई छड़ी</h3>
            <p class="story-card-text">
              परियों की दुनिया से धरती घूमने आई एक परी की कहानी।
            </p>
            <div class="story-card-footer">
              <span class="story-card-age">Ages 3–6</span>
              <div class="story-card-play" id="playBtn1">▶</div>
            </div>
          </div>
        </div>

        <!-- Story Card 2 -->
        <div class="story-card animate-on-scroll animate-delay-2" id="storyCard2">
          <div class="story-card-image">
            <img src="assets/images/story_card_2.png" alt="Under the Sea fairy tale" />
            <span class="story-card-badge">Popular</span>
            <span class="story-card-duration">🕐 10 min</span>
          </div>
          <div class="story-card-body">
            <h3 class="story-card-title">परी की जादुई छड़ी</h3>
            <p class="story-card-text">
              परियों की दुनिया से धरती घूमने आई एक परी की कहानी।
            </p>
            <div class="story-card-footer">
              <span class="story-card-age">Ages 4–8</span>
              <div class="story-card-play" id="playBtn2">▶</div>
            </div>
          </div>
        </div>

        <!-- Story Card 3 -->
        <div class="story-card animate-on-scroll animate-delay-3" id="storyCard3">
          <div class="story-card-image">
            <img src="assets/images/story_card_3.png" alt="മഴവില്ല് തൊട്ട കുഞ്ഞന്‍ ഓന്ത്  fairy tale" />
            <span class="story-card-badge">Favorite</span>
            <span class="story-card-duration">🕐 12 min</span>
          </div>
          <div class="story-card-body">
            <h3 class="story-card-title">മഴവില്ല് തൊട്ട കുഞ്ഞന്‍ ഓന്ത് </h3>
            <p class="story-card-text">
              ഭൂമിയിലെ എല്ലാറ്റിനും നിറം കിട്ടിയതിനു പിന്നിലെ കഥ. 
            </p>
            <div class="story-card-footer">
              <span class="story-card-age">Ages 5–10</span>
              <div class="story-card-play" id="playBtn3">▶</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="section how-section" id="how-it-works">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <div class="section-tag">✨ How It Works</div>
        <h2 class="section-title">Three Simple <span>Steps</span> to Dreamland</h2>
        <p class="section-subtitle">
          Getting started is as easy as tucking in your little one.
        </p>
      </div>

      <div class="how-grid">
        <div class="how-step animate-on-scroll animate-delay-1" id="howStep1">
          <div class="how-step-icon">
            📖
            <span class="how-step-number">1</span>
          </div>
          <h3 class="how-step-title">Choose a Story</h3>
          <p class="how-step-text">
            Browse our magical library of over 200 bedtime stories for every age and mood.
          </p>
        </div>

        <div class="how-step animate-on-scroll animate-delay-2" id="howStep2">
          <div class="how-step-icon">
            🎧
            <span class="how-step-number">2</span>
          </div>
          <h3 class="how-step-title">Listen Together</h3>
          <p class="how-step-text">
            Snuggle up and enjoy the soothing narration with calming background music.
          </p>
        </div>

        <div class="how-step animate-on-scroll animate-delay-3" id="howStep3">
          <div class="how-step-icon">
            💤
            <span class="how-step-number">3</span>
          </div>
          <h3 class="how-step-title">Drift to Sleep</h3>
          <p class="how-step-text">
            Watch your little one drift into peaceful, happy dreams full of wonder.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TESTIMONIALS ========== -->
  <section class="section testimonials-section" id="testimonials">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <div class="section-tag">💛 Happy Families</div>
        <h2 class="section-title">Loved by <span>Parents</span> Everywhere</h2>
        <p class="section-subtitle">
          See what families are saying about their bedtime routine transformation.
        </p>
      </div>

      <div class="testimonials-grid">
        <div class="testimonial-card animate-on-scroll animate-delay-1" id="testimonial1">
          <p class="testimonial-text">
            "LALA Kids has completely transformed our bedtime routine. My daughter now
            looks forward to sleeping because she can't wait for her nightly story!"
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">S</div>
            <div>
              <div class="testimonial-name">Sarah Mitchell</div>
              <div class="testimonial-role">Mom of 2 · Ages 4 & 7</div>
            </div>
          </div>
        </div>

        <div class="testimonial-card animate-on-scroll animate-delay-2" id="testimonial2">
          <p class="testimonial-text">
            "The stories are beautifully narrated and the illustrations are absolutely
            stunning. My son asks for 'just one more story' every night!"
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">J</div>
            <div>
              <div class="testimonial-name">James Rodriguez</div>
              <div class="testimonial-role">Dad of 1 · Age 5</div>
            </div>
          </div>
        </div>

        <div class="testimonial-card animate-on-scroll animate-delay-3" id="testimonial3">
          <p class="testimonial-text">
            "As a teacher, I recommend LALA Kids to all parents. The stories are
            age-appropriate, educational, and absolutely magical. A must-have app!"
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">E</div>
            <div>
              <div class="testimonial-name">Emily Chen</div>
              <div class="testimonial-role">Kindergarten Teacher</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== APP SHOWCASE ========== -->
  <section class="section app-section" id="app-showcase">
    <!-- Animated background elements -->
    <div class="app-bg-shapes">
      <div class="app-shape app-shape-1"></div>
      <div class="app-shape app-shape-2"></div>
      <div class="app-shape app-shape-3"></div>
      <div class="app-shape app-shape-4"></div>
      <div class="app-shape app-shape-5"></div>
      <div class="app-bg-dots" id="appBgDots"></div>
      <div class="app-bg-star app-bg-star-1">⭐</div>
      <div class="app-bg-star app-bg-star-2">🌟</div>
      <div class="app-bg-star app-bg-star-3">✨</div>
      <div class="app-bg-moon">🌙</div>
    </div>
    <div class="container">
      <div class="app-content">
        <div class="app-text animate-on-scroll">
          <div class="section-tag">📱 Our App</div>
          <h2 class="section-title">Storytime in Your <span>Pocket</span></h2>
          <p class="section-subtitle" style="text-align:left; margin:0 0 32px;">
            Download the LALA Stories app and carry hundreds of magical bedtime tales wherever you go.
          </p>

          <div class="app-features">
            <div class="app-feature animate-on-scroll animate-delay-1">
              <div class="app-feature-icon">🎙️</div>
              <div>
                <h4 class="app-feature-title">Soothing Narration</h4>
                <p class="app-feature-text">Professional voices with calming background music</p>
              </div>
            </div>
            <div class="app-feature animate-on-scroll animate-delay-2">
              <div class="app-feature-icon">⏰</div>
              <div>
                <h4 class="app-feature-title">Sleep Timer</h4>
                <p class="app-feature-text">Auto-stop so the story ends when your child drifts off</p>
              </div>
            </div>
            <div class="app-feature animate-on-scroll animate-delay-3">
              <div class="app-feature-icon">📚</div>
              <div>
                <h4 class="app-feature-title">New Stories Weekly</h4>
                <p class="app-feature-text">Fresh tales added every week to keep bedtime exciting</p>
              </div>
            </div>
            <div class="app-feature animate-on-scroll animate-delay-4">
              <div class="app-feature-icon">🔒</div>
              <div>
                <h4 class="app-feature-title">100% Kid-Safe</h4>
                <p class="app-feature-text">No ads, no in-app purchases, fully parent-approved</p>
              </div>
            </div>
          </div>

          <!-- Real App Store / Play Store Buttons -->
          <div class="app-buttons animate-on-scroll">
            <a href="https://lalakidsstories.page.link/share" class="app-store-btn app-store-apple" id="appStoreBtn" aria-label="Download on the App Store">
              <svg class="store-badge-svg" viewBox="0 0 165 50" xmlns="http://www.w3.org/2000/svg">
                <rect width="165" height="50" rx="8" fill="#000" />
                <rect width="165" height="50" rx="8" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
                <!-- Apple logo -->
                <path
                  d="M22.7 25.6c0-3.5 1.9-6.7 4.8-8.5a9.7 9.7 0 0 0-7.7-4.2C16.7 12.6 13.5 15 12 15c-1.7 0-4.2-1.8-7-1.8a10.2 10.2 0 0 0-8.6 5.2c-3.7 6.4-.9 15.8 2.6 21a13.3 13.3 0 0 0 6.6 5.3c2.7-.1 3.7-1.7 7-1.7 3.2 0 4.1 1.7 6.9 1.6A14 14 0 0 0 26 39a21 21 0 0 0 2.9-6A9.3 9.3 0 0 1 22.7 25.6z"
                  fill="#fff" transform="translate(14, 5) scale(0.42)" />
                <path d="M35.6 11a9.3 9.3 0 0 0 5.4-4.8 9.5 9.5 0 0 0-6.4 3.3A9 9 0 0 0 32.3 15a7.9 7.9 0 0 0 3.3-4z"
                  fill="#fff" transform="translate(14, 5) scale(0.42)" />
                <text x="44" y="19" font-family="-apple-system,Helvetica,Arial,sans-serif" font-size="9"
                  fill="rgba(255,255,255,0.75)" letter-spacing="0.3">Download on the</text>
                <text x="44" y="34" font-family="-apple-system,Helvetica,Arial,sans-serif" font-size="17"
                  font-weight="600" fill="#fff">App Store</text>
              </svg>
            </a>
            <a href="https://lalakidsstories.page.link/share" class="app-store-btn app-store-google" id="playStoreBtn" aria-label="Get it on Google Play">
              <svg class="store-badge-svg" viewBox="0 0 165 50" xmlns="http://www.w3.org/2000/svg">
                <rect width="165" height="50" rx="8" fill="#000" />
                <rect width="165" height="50" rx="8" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
                <defs>
                  <linearGradient id="gplay-tl" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#00C3F7" />
                    <stop offset="100%" stop-color="#009BF7" />
                  </linearGradient>
                  <linearGradient id="gplay-tr" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#3DD784" />
                    <stop offset="100%" stop-color="#00E676" />
                  </linearGradient>
                  <linearGradient id="gplay-bl" x1="100%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#FFD600" />
                    <stop offset="100%" stop-color="#FFAB00" />
                  </linearGradient>
                  <linearGradient id="gplay-br" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#FF5252" />
                    <stop offset="100%" stop-color="#C51162" />
                  </linearGradient>
                </defs>
                <!-- Play icon - 4 coloured triangles -->
                <polygon points="14,10 14,25 26,17.5" fill="url(#gplay-tl)" />
                <polygon points="14,25 14,40 26,32.5" fill="url(#gplay-bl)" />
                <polygon points="14,10 26,17.5 14,25" fill="url(#gplay-tr)" />
                <polygon points="14,25 26,32.5 14,40" fill="url(#gplay-br)" />
                <polygon points="26,17.5 32,25 26,32.5" fill="url(#gplay-br)" />
                <text x="40" y="19" font-family="-apple-system,Helvetica,Arial,sans-serif" font-size="9"
                  fill="rgba(255,255,255,0.75)" letter-spacing="0.5">GET IT ON</text>
                <text x="40" y="34" font-family="-apple-system,Helvetica,Arial,sans-serif" font-size="16"
                  font-weight="600" fill="#fff">Google Play</text>
              </svg>
            </a>
          </div>
        </div>

        <!-- 3D Phone Carousel -->
        <div class="app-carousel-wrapper animate-on-scroll" id="appCarouselWrapper">
          <div class="app-carousel-stage" id="appCarouselStage">
            <!-- Card 0: active/center -->
            <div class="app-phone-card active" data-index="0">
              <div class="app-phone-frame">
                <div class="app-phone-notch"></div>
                <div class="app-phone-screen">
                  <img src="assets/images/show-image4.jpeg" alt="LALA app - Home screen" loading="lazy" />
                </div>
                <div class="app-phone-btn"></div>
              </div>
            </div>
            <!-- Card 1 -->
            <div class="app-phone-card" data-index="1">
              <div class="app-phone-frame">
                <div class="app-phone-notch"></div>
                <div class="app-phone-screen">
                  <img src="assets/images/show_image1.jpeg" alt="Battle of the Ants" loading="lazy" />
                </div>
                <div class="app-phone-btn"></div>
              </div>
            </div>
            <!-- Card 2 -->
            <div class="app-phone-card" data-index="2">
              <div class="app-phone-frame">
                <div class="app-phone-notch"></div>
                <div class="app-phone-screen">
                  <img src="assets/images/show_image2.jpeg" alt="Battle of the Ants" loading="lazy" />
                </div>
                <div class="app-phone-btn"></div>
              </div>
            </div>
            <!-- Card 3 -->
            <div class="app-phone-card" data-index="3">
              <div class="app-phone-frame">
                <div class="app-phone-notch"></div>
                <div class="app-phone-screen">
                  <img src="assets/images/show_image3.jpeg" alt="മഴവില്ല് തൊട്ട കുഞ്ഞന്‍ ഓന്ത് " loading="lazy" />
                </div>
                <div class="app-phone-btn"></div>
              </div>
            </div>
          </div>

          <!-- Screen label -->
          <div class="app-carousel-label" id="appCarouselLabel">Home Screen</div>

          <!-- Dots -->
          <div class="app-carousel-dots" id="appCarouselDots">
            <button class="app-dot active" data-idx="0" aria-label="Screen 1"></button>
            <button class="app-dot" data-idx="1" aria-label="Screen 2"></button>
            <button class="app-dot" data-idx="2" aria-label="Screen 3"></button>
            <button class="app-dot" data-idx="3" aria-label="Screen 4"></button>
          </div>

          <!-- Arrows -->
          <button class="app-carousel-arrow app-arrow-prev" id="appArrowPrev" aria-label="Previous">&#8249;</button>
          <button class="app-carousel-arrow app-arrow-next" id="appArrowNext" aria-label="Next">&#8250;</button>

          <!-- Glow -->
          <div class="app-carousel-glow"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CTA SECTION ========== -->
  <section class="cta-section" id="cta">
    <div class="cta-stars" id="ctaStars"></div>
    <div class="container cta-content">
      <div class="cta-emoji animate-on-scroll">🌙</div>
      <h2 class="cta-title animate-on-scroll animate-delay-1">
        Ready for <span>Magical</span> Bedtimes?
      </h2>
      <p class="cta-text animate-on-scroll animate-delay-2">
        Join thousands of happy families and make bedtime the best part of the day.
        Start your free trial tonight!
      </p>
      <a href="https://lalakidsstories.page.link/share" class="cta-btn animate-on-scroll animate-delay-3" id="ctaBtn">
        Start Free Trial 🌟
      </a>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer class="footer" id="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="#" class="logo">
            <img src="assets/images/LALA logo- PNG.png" alt="LALA Stories" class="logo-img footer-logo-img" />
          </a>
          <p class="footer-brand-text">
            Making bedtime magical, one story at a time. Sweet dreams start here.
          </p>
          <div class="footer-socials">
            <a href="#" class="footer-social" id="socialFacebook" aria-label="Facebook">📘</a>
            <a href="#" class="footer-social" id="socialInstagram" aria-label="Instagram">📸</a>
            <a href="#" class="footer-social" id="socialTwitter" aria-label="Twitter">🐦</a>
            <a href="#" class="footer-social" id="socialYoutube" aria-label="YouTube">📺</a>
          </div>
        </div>

        <div>
          <h4 class="footer-col-title">Stories</h4>
          <div class="footer-links">
            <a href="#">Bedtime Classics</a>
            <a href="#">Fairy Tales</a>
            <a href="#">Adventure Stories</a>
            <a href="#">Lullaby Tales</a>
          </div>
        </div>

        <div>
          <h4 class="footer-col-title">Company</h4>
          <div class="footer-links">
            <a href="#">About Us</a>
            <a href="#">Careers</a>
            <a href="#">Blog</a>
            <a href="#">Contact</a>
          </div>
        </div>

        <div>
          <h4 class="footer-col-title">Support</h4>
          <div class="footer-links">
            <a href="#">Help Center</a>
            <a href="#">Safety</a>
            <a href="#">Parental Guide</a>
            <a href="#">FAQ</a>
          </div>
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-bottom">
        <p>© 2026 LALA Stories. All rights reserved. Made with 💛 for little dreamers.</p>
        <div class="footer-bottom-links">
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="#">Cookies</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- ========== QR CODE DOWNLOAD POPUP ========== -->
  <div class="qr-overlay" id="qrOverlay"></div>
  <div class="qr-popup" id="qrPopup">
    <button class="qr-close" id="qrClose" aria-label="Close popup">&times;</button>
    <div class="qr-popup-inner">
      <div class="qr-emoji">🎁</div>
      <h3 class="qr-title">Get the <span>LALA</span> App</h3>
      <p class="qr-text">
        Scan the code or click below to explore magical stories on your phone.
      </p>
      <div class="qr-image-wrap">
        <img src="assets/images/qr_code.png" alt="QR Code" class="qr-image" />
        <div class="qr-image-glow"></div>
      </div>
      <div class="qr-stores">
        <a href="https://lalakidsstories.page.link/share" class="app-store-btn qr-store-btn" aria-label="App Store">
          <small>Download on</small>
          <strong>App Store</strong>
        </a>
        <a href="https://lalakidsstories.page.link/share" class="app-store-btn qr-store-btn" aria-label="Google Play">
          <small>Get it on</small>
